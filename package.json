{
  "name": "bounty-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Bounty: Machine-to-Machine Subcontracting & Autonomous Resource Arbitrage via PayPal",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "tsx scripts/start-all.ts",
    "build": "npm run build --workspace=@bounty/protocol && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "cli": "npm run dev --workspace=@bounty/cli",
    "bounty": "tsx packages/cli/src/index.ts",
    "broker": "npm run dev --workspace=@bounty/broker",
    "dashboard": "npm run dev --workspace=@bounty/dashboard",
    "demo:cloudflare": "tsx examples/01-cloudflare-bypass/run.ts"
  },
  "bin": {
    "bounty": "./packages/cli/dist/index.js"
  },
  "keywords": [
    "paypal",
    "mcp",
    "agentic-commerce",
    "multi-agent",
    "subcontracting",
    "micro-payouts",
    "ag-grid"
  ],
  "author": "Bounty Team",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "playwright": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}

# PayPal Developer Configuration
# Leave blank to use the High-Fidelity Sandbox Simulator (zero-setup)
# Or add your credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SELLER_EMAIL=seller-dev@sandbox.paypal.com
PAYPAL_BUYER_EMAIL=buyer-agent@sandbox.paypal.com

# Bounty Network & Broker Configuration
BOUNTY_BROKER_PORT=4000
BOUNTY_BROKER_HOST=localhost
BOUNTY_BROKER_URL=ws://localhost:4000/ws/seller
BOUNTY_API_URL=http://localhost:4000

# Web Dashboard Port
VITE_DASHBOARD_PORT=5173

# Logging & Telemetry
LOG_LEVEL=info
DEBUG=bounty:*

